<UserControl x:Class="AsLab.Ui.KartuStatistik"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Akar">
    <!-- Kartu angka di dashboard. Pemakaian: <ui:KartuStatistik Judul="Praktikan" Nilai="120" Ikon="&#xE716;" /> -->
    <Border Style="{StaticResource Kartu}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Judul, ElementName=Akar}" Style="{StaticResource Redup}" />
                <TextBlock Text="{Binding Nilai, ElementName=Akar}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Keterangan, ElementName=Akar}" Style="{StaticResource Redup}" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Top"
                    Background="{DynamicResource UtamaLembut}">
                <TextBlock Style="{StaticResource Ikon}" Text="{Binding Ikon, ElementName=Akar}" FontSize="18"
                           Foreground="{DynamicResource Utama}" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
