<UserControl x:Class="AsLab.Views.Akademik.RekapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Width="240">
                    <TextBlock Text="Kelas" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding DaftarKelas}" SelectedItem="{Binding KelasTerpilih}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0" />
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Margin="0,0,8,0" />
                    <Button Content="Finalisasi &amp; Kunci" Command="{Binding KunciCommand}" Style="{DynamicResource AccentButtonStyle}"
                            Visibility="{Binding BisaKunci, Converter={StaticResource BoolKeVisibility}}" />
                    <Button Content="Buka Kunci" Command="{Binding BukaKunciCommand}"
                            Visibility="{Binding BisaBukaKunci, Converter={StaticResource BoolKeVisibility}}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Keterangan}" Style="{StaticResource Redup}" Margin="0,12,0,0" />

            <Border Style="{StaticResource BannerKunci}" Margin="0,10,0,0"
                    Visibility="{Binding Terkunci, Converter={StaticResource BoolKeVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Ikon}" Text="&#xE72E;" Margin="0,0,8,0" />
                    <TextBlock Text="Nilai kelas ini sudah difinalisasi dan dikunci." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding PesanError}" Style="{StaticResource PesanError}" Margin="0,10,0,0" />
            <TextBlock Text="{Binding PesanSukses}" Style="{StaticResource PesanSukses}" Margin="0,10,0,0" />
            <TextBlock Text="Klik dua kali baris untuk melihat detail praktikan." Style="{StaticResource Redup}" FontSize="12" Margin="0,10,0,8" />
        </StackPanel>

        <!-- Kolom M1..Mn ditambahkan dari code-behind karena jumlah modul berbeda tiap mata praktikum. -->
        <DataGrid x:Name="Tabel" ItemsSource="{Binding Baris}" SelectedItem="{Binding BarisTerpilih}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" FontSize="13">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding BukaDetailCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource SelTeks}" Header="NRP" Binding="{Binding Nrp}" Width="108" />
                <DataGridTextColumn ElementStyle="{StaticResource SelTeks}" Header="Nama" Binding="{Binding Nama}" Width="190" />
                <DataGridTextColumn ElementStyle="{StaticResource SelTeks}" Header="Sementara" Binding="{Binding NilaiSementara, StringFormat=0.00}" Width="100" />
                <DataGridTextColumn ElementStyle="{StaticResource SelTeks}" Header="Nilai Akhir" Binding="{Binding NilaiAkhir, StringFormat=0.00}" Width="100" />
                <DataGridTextColumn ElementStyle="{StaticResource SelTeks}" Header="Huruf" Binding="{Binding Huruf}" Width="76" />
                <DataGridTextColumn ElementStyle="{StaticResource SelTeks}" Header="Kehadiran" Binding="{Binding KehadiranTeks}" Width="100" />
                <DataGridTemplateColumn Header="Status" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Badge status, ditambah tanda ⚠ bila praktikan berisiko (arahkan mouse untuk alasannya) -->
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <Border Style="{StaticResource Badge}" Tag="{Binding Status}">
                                    <TextBlock Text="{Binding Status}" />
                                </Border>
                                <TextBlock Text="⚠" Foreground="{DynamicResource Bahaya}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" ToolTip="{Binding AlasanRisiko}"
                                           Visibility="{Binding Berisiko, Converter={StaticResource BoolKeVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
